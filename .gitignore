# OS
.DS_Store
Thumbs.db

# Large binary files (not suitable for version control)
*.pdf
*.pptx
*.xlsx

# Editor SDK temp files
redact_kit/uploads/
redact_kit/static/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Build outputs
dist/
build/

# JSON content dumps (contain document content, keep source doc)
_full_doc_content.json
_v3_doc_content.json

# Redaction outputs (deliverables, not source)
output/

# Agent workspace memory
.workbuddy/

# Work documents (client files, never commit binaries)
工作目录/
共建项目/
!工作目录/*.md

# Sandbox probe residue (environment-generated, not project files)
/[0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_]
**/[0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_][0-9a-z_]
wtest_probe.txt
.wb_*

# 测试执行临时区（测试辅助物与基线副本，不入库）
.tmpwork/

# 断点续传状态文件（运行时产物，默认落在输出目录；此处兜底 CWD 残留）
.redact_state.json

# 探针残留
zz_probe_normal.txt
/-
