# OS
.DS_Store
Thumbs.db

# Large binary files (not suitable for version control)
*.pdf
*.pptx
*.xlsx

# Editor SDK temp files
redact_kit/uploads/
redact_kit/static/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Build outputs
dist/
build/

# JSON content dumps (contain document content, keep source doc)
_full_doc_content.json
_v3_doc_content.json

# Redaction outputs (deliverables, not source)
output/

# Agent workspace memory
.workbuddy/

# Work documents (client files, never commit binaries)
工作目录/
共建项目/
!工作目录/*.md
