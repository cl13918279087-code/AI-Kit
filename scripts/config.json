  "redaction": {
    "llm_enabled": true,
    "llm_confidence_threshold": 0.75,
    "llm_chunk_size": 6000,
    "llm_overlap_chars": 200,
    "auto_verify": true,
    "date_format": "YYYY/MM/DD",
    "date_format_chinese": "YYYY年MM月DD日",
    "preserve_date_range_connector": true,
    "preserve_sequence_words": true
  },
  "batch": {
    "max_workers": 5,
    "chunk_size": 5,
    "progress_interval": 1,
    "resume_enabled": true
  },
