{
  "name": "doc-redact-project",
  "version": "1.0.0",
  "description": "金融文档智能脱敏工具包 - 支持 Word/Excel/PPT/PDF/图片批量脱敏",

  "llm": {
    "provider": "minimax",
    "model": "MiniMax-Text-01",
    "base_url": "https://api.minimaxi.com/v1",
    "api_key": "${MINIMAX_API_KEY}",
    "timeout": 120,
    "max_retries": 3,
    "fallback_models": ["MiniMax-Text-01"]
  },

  "replacement": {
    "EMAIL": "XXXXX@XXXXX",
    "ADDRESS": "XX省XX市XX区XXXX",
    "ID_CARD": "XXXXXXXXXXXXXXXXXX",
    "BANK_CARD": "XXXXXXXXXXXXXXXX",
    "DATE": "YYYY/MM/DD",
    "DATE_CHINESE": "YYYY年MM月DD日",
    "MOBILE": "XXXXXXXXXXX",
    "PHONE": "0XX-XXXXXXXX",
    "BANK": "XX银行",
    "ORG": "XXXX",
    "NAME": "XXX",
    "AMOUNT": "[金额]",
    "IP": "X.X.X.X",
    "MAC": "XX:XX:XX:XX:XX:XX"
  },

  "bank_names": [
    "中国工商银行", "中国农业银行", "中国银行", "中国建设银行", "交通银行",
    "招商银行", "浦发银行", "兴业银行", "民生银行", "华夏银行", "平安银行",
    "光大银行", "广发银行", "浙商银行", "渤海银行", "恒丰银行",
    "中国邮政储蓄银行", "中国人民银行",
    "北京银行", "上海银行", "南京银行", "宁波银行", "杭州银行", "深圳前海微众银行",
    "江苏银行", "徽商银行", "重庆银行", "天津银行", "成都银行", "西安银行",
    "苏州银行", "武汉众邦银行", "长沙银行", "青岛银行", "齐鲁银行",
    "大连银行", "盛京银行", "哈尔滨银行", "吉林银行", "辽宁振兴银行",
    "河北银行", "廊坊银行", "沧州银行",
    "福建海峡银行", "海峡银行",
    "郑州银行", "中原银行", "焦作中旅银行",
    "重庆三峡银行", "重庆农村商业银行",
    "成都银行", "成都农商银行",
    "贵州银行", "贵阳银行", "贵州农信",
    "广西北部湾银行", "广西农村合作金融机构",
    "海南银行", "海南省农信社",
    "山西银行", "晋商银行",
    "甘肃银行", "甘肃农信",
    "内蒙古银行", "内蒙古农信",
    "新疆银行", "新疆农信",
    "农信社", "信用社", "农商银行", "农村合作银行", "村镇银行", "农村商业银行"
  ],

  "org_suffixes": [
    "组", "部", "公司", "科", "室", "处", "中心",
    "分行", "支行", "事业部", "运营部", "科技部",
    "管委会", "办公室", "董事会", "监事会"
  ],

  "surname_pool": "赵钱孙李周吴郑王冯陈褚卫蒋沈韩杨朱秦尤许何吕施张孔曹严华金魏陶姜戚谢邹喻柏水窦章云苏潘葛奚范彭郎鲁韦昌马苗凤花方俞任袁柳酆鲍史唐费廉岑薛雷贺倪汤滕殷罗毕郝邬安常乐于时傅皮卞齐康伍余元卜顾孟平黄和穆萧尹姚邵湛汪祁毛禹狄米贝明臧计伏成戴谈宋茅庞熊纪舒屈项祝董梁杜阮蓝闵席季麻强贾路娄危江童颜郭梅盛林刁钟徐骆高夏蔡田樊胡凌霍虞万支柯昝管卢莫经房裘缪干解应宗丁宣邓单洪包诸左石崔吉钮龚林门龙段郑孔牛童浦施零厉刘",

  "redaction": {
    "llm_enabled": true,
    "llm_confidence_threshold": 0.75,
    "llm_chunk_size": 6000,
    "llm_overlap_chars": 200,
    "auto_verify": true,
    "date_format": "YYYY/MM/DD",
    "date_format_chinese": "YYYY年MM月DD日",
    "preserve_date_range_connector": true,
    "preserve_sequence_words": true
  },

  "batch": {
    "max_workers": 5,
    "chunk_size": 5,
    "progress_interval": 1,
    "resume_enabled": true
  },

  "image": {
    "method": "mosaic",
    "mosaic_block_size": 16,
    "blur_radius": 15,
    "logo_detection": true
  },

  "tesseract": {
    "path": null,
    "lang": "chi_sim+eng",
    "mac_path": "/opt/homebrew/bin/tesseract",
    "linux_path": "/usr/bin/tesseract",
    "windows_path": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
  },

  "output": {
    "suffix": "_脱敏",
    "overwrite": false,
    "create_manifest": true,
    "manifest_format": "markdown",
    "report_name": "脱敏报告_{timestamp}.md"
  },

  "exclude_patterns": [
    "^V\\d+\\.\\d+$",
    "^附件\\d+$",
    "^附录[A-Z]$",
    "^版本：",
    "^文档编号：",
    "^页码：",
    "系统", "业务系统", "核心系统", "外围系统",
    "流程", "操作流程", "业务流程", "审批流程",
    "演练", "业务演练", "切换演练", "灾备演练",
    "密码", "登录密码", "交易密码",
    "用户名", "总行支持人员"
  ]
}
